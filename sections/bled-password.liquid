{% comment %}
  BLED FAKE — Shopify Native Password Template Section (bled-password.liquid)
  Renders Shopify storefront_password form with BLED BLOCKS brutalist design.
{% endcomment %}

<section class="bf-page bf-gate-page" aria-label="BLED FAKE — Restricted Access">
  <div class="bf-grain" aria-hidden="true"></div>
  <div class="bf-gate-ambient-glow" aria-hidden="true"></div>

  <header class="bf-header bf-gate-header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>

    <div class="bf-gate-status-pill">
      <span class="bf-status-dot"></span>
      <span>STORE // RESTRICTED ACCESS</span>
    </div>
  </header>

  <div class="bf-gate-terminal">
    <div class="bf-gate-card">

      <div class="bf-gate-eyebrow">
        <span class="bf-gate-code">GATE // DROP ARCHIVE</span>
        <span class="bf-gate-divider">/</span>
        <span>ACCESS REQUIRED</span>
      </div>

      <h1 class="bf-gate-title">ENTER THE REALITY</h1>
      <p class="bf-gate-subtitle">WE DON'T HATE TUNISIA. WE HATE THE ILLUSION.</p>
      <div class="bf-gate-notice">RESTRICTED ACCESS // ENTER PASSCODE TO UNLOCK THE DROP</div>

      {% form 'storefront_password', class: 'bf-gate-form', id: 'bf-shopify-password-form' %}
        {% if form.errors %}
          <div class="bf-gate-error" role="alert">
            <span>[ ACCESS DENIED // {{ form.errors | default_errors | strip_html | upcase }} ]</span>
          </div>
        {% endif %}

        <div class="bf-gate-input-wrap">
          <input
            type="password"
            name="password"
            id="Password"
            class="bf-gate-input"
            placeholder="ENTER PASSCODE..."
            autocomplete="current-password"
            required
            aria-label="Enter store passcode"
          >
        </div>

        <button type="submit" class="bf-gate-submit-btn">
          <span>UNLOCK ACCESS</span>
          <span class="bf-gate-btn-arrow" aria-hidden="true">➔</span>
        </button>
      {% endform %}

      <div class="bf-gate-footer-hint">
        <span>NO PASSCODE?</span>
        <a href="https://instagram.com/bledfake" target="_blank" rel="noopener" class="bf-gate-hint-link">
          FOLLOW @BLEDFAKE FOR DROP KEYS ↗
        </a>
      </div>

    </div>
  </div>

  <footer class="bf-gate-footer">
    <div class="bf-gate-footer__item">
      <span class="bf-gate-footer__dim">STATUS:</span>
      <span>LOCKED (AUTHENTICATION REQUIRED)</span>
    </div>
    <div class="bf-gate-footer__item">
      <span>BLED FAKE // BLED BLOCKS DESIGN SYSTEM</span>
    </div>
    <div class="bf-gate-footer__item">
      <span>© {{ 'now' | date: '%Y' }} TUNIS, TN</span>
    </div>
  </footer>
</section>

{% schema %}
{
  "name": "BLED Password Page",
  "settings": []
}
{% endschema %}
