{% comment %}
  BLED FAKE — About Page Section (bled-about.liquid)
  Brand story, founders, philosophy, underground ethos.
{% endcomment %}

<section class="bf-page bf-about-page" aria-label="About BLED FAKE">
  <div class="bf-grain" aria-hidden="true"></div>

  <!-- Header -->
  <header class="bf-header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>
    <div class="bf-nav-right">
      <button class="bf-nav-btn" data-cart-open aria-label="Open cart">
        <span>BAG</span>
        <span class="bf-cart-badge-count bf-cart-count">{{ cart.item_count }}</span>
      </button>
      <button class="bf-nav-btn" data-menu-open aria-label="Open menu">
        <span>MENU</span>
        <div class="bf-hamburger" aria-hidden="true">
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
        </div>
      </button>
    </div>
  </header>

  <!-- Page Title -->
  <div class="bf-page-hero">
    <div class="bf-page-hero__eyebrow">IDENTITY // 2024</div>
    <h1 class="bf-page-hero__title">ABOUT<br>BLED FAKE</h1>
    <div class="bf-page-hero__rule"></div>
  </div>

  <!-- About Content Grid -->
  <div class="bf-about-grid">

    <!-- Left: Big Statement -->
    <div class="bf-about-statement">
      <p class="bf-about-statement__text">
        We don't hate Tunisia.<br>
        We hate the illusion.
      </p>
      <p class="bf-about-statement__sub">
        BLED FAKE is an underground streetwear label born in the streets of Tunis.
        Not a brand. A document. Every garment is evidence.
      </p>
    </div>

    <!-- Right: Story -->
    <div class="bf-about-story">

      <div class="bf-about-block">
        <span class="bf-about-block__num">01</span>
        <h2 class="bf-about-block__title">THE NAME</h2>
        <p class="bf-about-block__body">
          <em>Bled</em> means homeland in Tunisian Arabic. <em>Fake</em> is the mirror we hold up to it.
          Not as an insult — as a diagnosis. We exist in the space between what Tunisia is
          and what it pretends to be. That gap is where underground culture is born.
        </p>
      </div>

      <div class="bf-about-block">
        <span class="bf-about-block__num">02</span>
        <h2 class="bf-about-block__title">THE GARMENTS</h2>
        <p class="bf-about-block__body">
          Each piece is designed in Tunis and produced in limited quantities.
          We use heavyweight organic cottons, technical ripstop, and screen-printed
          graphics with puff ink. Every drop tells a chapter of the same story.
          No restocks. No middlemen. No compromises.
        </p>
      </div>

      <div class="bf-about-block">
        <span class="bf-about-block__num">03</span>
        <h2 class="bf-about-block__title">THE COLLECTIONS</h2>
        <p class="bf-about-block__body">
          <strong>BLED FAKE</strong> — The original line. Confrontational graphics, over-sized silhouettes,
          and typographic manifesto prints.<br><br>
          <strong>BLED HORRA</strong> — Free Tunisia. Experimental cuts, muted tones, and raw fabrication.<br><br>
          <strong>COMEBACK TOMORROW</strong> — Technical outerwear and accessories. Built for the streets, built to last.
        </p>
      </div>

      <div class="bf-about-block">
        <span class="bf-about-block__num">04</span>
        <h2 class="bf-about-block__title">WHERE WE STAND</h2>
        <p class="bf-about-block__body">
          We ship from Tunis to the world. Cash on delivery within Tunisia.
          Flouci & card for everywhere else. Direct to your door,
          no retail mark-up, no hype tax.
        </p>
      </div>

    </div>
  </div>

  <!-- CTA Band -->
  <div class="bf-page-cta-band">
    <a href="/collections/all" class="bf-page-cta-btn">
      <span>SHOP THE DROPS</span>
      <span>→</span>
    </a>
    <a href="/pages/manifesto" class="bf-page-cta-btn bf-page-cta-btn--outline">
      <span>READ THE MANIFESTO</span>
      <span>→</span>
    </a>
  </div>

  <!-- Footer -->
  <footer class="bf-page-footer" aria-label="Page footer">
    <span>BLED FAKE // TUNIS // {{ 'now' | date: '%Y' }}</span>
    <span>BLEDFAKE 2026</span>
  </footer>

</section>

{% schema %}
{
  "name": "BLED About",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "BLED About Page" }]
}
{% endschema %}
