{% comment %}
  BLED FAKE — Countdown Landing Page (bled-countdown.liquid)
  Cinematic Brutalist Pre-launch Countdown Page with Hero Image Background.
  Target: December 1, 2026 — WLED BLED DROP DAY
{% endcomment %}

<section class="bf-countdown-page" id="bf-countdown" aria-label="BLED FAKE — WLED BLED DROP DAY">

  <!-- Background Image Wrap -->
  <div class="bf-countdown-bg-wrap" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      <img
        src="{{ section.settings.background_image | image_url: width: 2000 }}"
        alt="BLED FAKE Background"
        class="bf-countdown-bg-img"
        loading="eager"
      >
    {%- else -%}
      <img
        src="{{ 'landing-hero.jpg' | asset_url }}"
        alt="BLED FAKE Background"
        class="bf-countdown-bg-img"
        loading="eager"
      >
    {%- endif -%}
    <div class="bf-countdown-overlay"></div>
  </div>

  <!-- Grain texture overlay -->
  <div class="bf-grain" aria-hidden="true"></div>

  <!-- Top Brand Header — logo centered on top -->
  <header class="bf-countdown-header bf-countdown-header--centered" role="banner">
    <img src="{{ 'MainLog.png' | asset_url }}" alt="BLED FAKE" class="bf-countdown-logo-img" width="52" height="58">
  </header>

  <!-- Center Content: Countdown & Headline -->
  <main class="bf-countdown-center" role="main">

    <!-- Drop Title — big, matches full countdown number scale -->
    <h1 class="bf-countdown-title bf-countdown-title--hero">{{ section.settings.drop_title | default: "WLED BLED DROP DAY" }}</h1>

    <div class="bf-countdown-timer bf-countdown-timer--compact" id="bf-countdown-timer" aria-live="polite">
      <div class="bf-countdown-card bf-countdown-card--sm">
        <span class="bf-countdown-num bf-countdown-num--sm" id="bf-cd-days">00</span>
        <span class="bf-countdown-label">DAYS</span>
      </div>
      <div class="bf-countdown-card bf-countdown-card--sm">
        <span class="bf-countdown-num bf-countdown-num--sm" id="bf-cd-hours">00</span>
        <span class="bf-countdown-label">HOURS</span>
      </div>
      <div class="bf-countdown-card bf-countdown-card--sm">
        <span class="bf-countdown-num bf-countdown-num--sm" id="bf-cd-mins">00</span>
        <span class="bf-countdown-label">MINUTES</span>
      </div>
      <div class="bf-countdown-card bf-countdown-card--sm">
        <span class="bf-countdown-num bf-countdown-num--sm" id="bf-cd-secs">00</span>
        <span class="bf-countdown-label">SECONDS</span>
      </div>
    </div>

    <!-- Waitlist Form -->
    <div class="bf-countdown-actions">

      <div class="bf-waitlist-heading">
        <span class="bf-status-dot"></span>
        <span>JOIN THE WAITLIST — BE FIRST TO KNOW</span>
      </div>

      {%- form 'customer', class: 'bf-waitlist-form', id: 'bf-waitlist-form' -%}
        <input type="hidden" name="contact[tags]" value="waitlist, wled_bled_drop">

        <div class="bf-waitlist-row" id="bf-waitlist-row">
          <input
            type="text"
            name="contact[first_name]"
            id="bf-waitlist-name"
            class="bf-waitlist-input"
            placeholder="YOUR NAME"
            autocomplete="given-name"
            aria-label="Enter your name"
          >
          <input
            type="email"
            name="contact[email]"
            id="bf-waitlist-email"
            class="bf-waitlist-input bf-waitlist-input--email"
            placeholder="YOUR EMAIL"
            autocomplete="email"
            aria-label="Enter your email"
            required
          >
          <button type="submit" class="bf-waitlist-btn" id="bf-waitlist-btn" aria-label="Join the waitlist">
            <span id="bf-waitlist-btn-text">JOIN</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>

        {%- if form.errors -%}
          <div class="bf-waitlist-error" id="bf-waitlist-error" role="alert" style="display:block;">
            [ {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }} ]
          </div>
        {%- else -%}
          <div class="bf-waitlist-error" id="bf-waitlist-error" role="alert" style="display:none;">
            [ ENTER A VALID EMAIL TO JOIN ]
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="bf-waitlist-success" id="bf-waitlist-success" style="display:block;">
            ✓ YOU'RE ON THE LIST — STAY TUNED
          </div>
        {%- else -%}
          <div class="bf-waitlist-success" id="bf-waitlist-success" style="display:none;">
            ✓ YOU'RE ON THE LIST — STAY TUNED
          </div>
        {%- endif -%}

        <p class="bf-waitlist-note">No spam. Drop notifications only.</p>
      {%- endform -%}

      <!-- Instagram Follow — smaller -->
      <a
        href="https://instagram.com/wledbled_"
        target="_blank"
        rel="noopener noreferrer"
        class="bf-countdown-cta bf-countdown-cta--sm"
      >
        <span>FOLLOW @WLEDBLED</span>
        <span class="bf-countdown-cta__arrow" aria-hidden="true">→</span>
      </a>

    </div>
  </main>

  <!-- Bottom Status Footer -->
  <footer class="bf-countdown-footer">
    <span>وِلاد البلاد ستوديو علامة تجارية مسجّلة</span>
    <span>TUNIS © {{ 'now' | date: '%Y' }} // ALL RIGHTS RESERVED</span>
  </footer>

</section>

<script>
(function() {
  // Target: December 1, 2026 00:00:00
  const targetDateStr = {{ section.settings.target_date | default: "2026-12-01T00:00:00" | json }};
  const targetTime = new Date(targetDateStr).getTime();

  const daysEl  = document.getElementById('bf-cd-days');
  const hoursEl = document.getElementById('bf-cd-hours');
  const minsEl  = document.getElementById('bf-cd-mins');
  const secsEl  = document.getElementById('bf-cd-secs');

  function updateCountdown() {
    const now = Date.now();
    const diff = targetTime - now;

    if (diff <= 0) {
      if (daysEl)  daysEl.textContent  = '00';
      if (hoursEl) hoursEl.textContent = '00';
      if (minsEl)  minsEl.textContent  = '00';
      if (secsEl)  secsEl.textContent  = '00';
      return;
    }

    const d = Math.floor(diff / (1000 * 60 * 60 * 24));
    const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const m = Math.floor((diff / (1000 * 60)) % 60);
    const s = Math.floor((diff / 1000) % 60);

    if (daysEl)  daysEl.textContent  = String(d).padStart(2, '0');
    if (hoursEl) hoursEl.textContent = String(h).padStart(2, '0');
    if (minsEl)  minsEl.textContent  = String(m).padStart(2, '0');
    if (secsEl)  secsEl.textContent  = String(s).padStart(2, '0');
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);

  // Waitlist form — submits directly to Shopify Customer database
  const waitlistForm    = document.getElementById('bf-waitlist-form');
  const waitlistEmail   = document.getElementById('bf-waitlist-email');
  const waitlistRow     = document.getElementById('bf-waitlist-row');
  const waitlistError   = document.getElementById('bf-waitlist-error');
  const waitlistSuccess = document.getElementById('bf-waitlist-success');
  const waitlistBtn     = document.getElementById('bf-waitlist-btn');
  const waitlistBtnText = document.getElementById('bf-waitlist-btn-text');

  function isValidEmail(v) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  }

  if (waitlistForm) {
    waitlistForm.addEventListener('submit', (e) => {
      const email = (waitlistEmail ? waitlistEmail.value : '').trim();

      if (!isValidEmail(email)) {
        e.preventDefault();
        if (waitlistSuccess) waitlistSuccess.style.display = 'none';
        if (waitlistError) {
          waitlistError.textContent = '[ ENTER A VALID EMAIL TO JOIN ]';
          waitlistError.style.display = 'block';
        }
        if (waitlistRow) {
          waitlistRow.classList.add('is-error');
          setTimeout(() => waitlistRow.classList.remove('is-error'), 600);
        }
        if (waitlistEmail) { waitlistEmail.focus(); }
        return;
      }

      // If running on Shopify with fetch support, submit asynchronously
      if (window.fetch && waitlistForm.action && waitlistForm.action.includes('/contact')) {
        e.preventDefault();
        if (waitlistBtnText) waitlistBtnText.textContent = '...';

        const formData = new FormData(waitlistForm);

        fetch(waitlistForm.action, {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8' }
        })
        .then(() => {
          if (waitlistError)   waitlistError.style.display   = 'none';
          if (waitlistSuccess) waitlistSuccess.style.display = 'block';
          if (waitlistRow)     waitlistRow.style.opacity     = '0.35';
          if (waitlistBtn)     waitlistBtn.disabled          = true;
          if (waitlistBtnText) waitlistBtnText.textContent   = '✓';
        })
        .catch(() => {
          // Fallback to normal submission
          waitlistForm.submit();
        });
      }
      // Otherwise allow standard form POST to handle submission
    });
  }
})();
</script>

{% schema %}
{
  "name": "BLED Countdown Drop",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "drop_title",
      "label": "Drop Title",
      "default": "WLED BLED DROP DAY"
    },
    {
      "type": "text",
      "id": "drop_subtitle",
      "label": "Drop Subtitle",
      "default": "DECEMBER 01, 2026 // FROM BLEDFAKE WITH LOVE"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target Drop Date (ISO format)",
      "default": "2026-12-01T00:00:00",
      "info": "Format: YYYY-MM-DDTHH:MM:SS"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ],
  "presets": [
    {
      "name": "BLED Countdown Drop"
    }
  ]
}
{% endschema %}
