{% comment %}
  BLED FAKE — Contact Page Section (bled-contact.liquid)
{% endcomment %}

<section class="bf-page bf-contact-page" aria-label="Contact BLED FAKE">
  <div class="bf-grain" aria-hidden="true"></div>

  <header class="bf-header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>
    <div class="bf-nav-right">
      <button class="bf-nav-btn" data-cart-open aria-label="Open cart">
        <span>BAG</span>
        <span class="bf-cart-badge-count bf-cart-count">{{ cart.item_count }}</span>
      </button>
      <button class="bf-nav-btn" data-menu-open aria-label="Open menu">
        <span>MENU</span>
        <div class="bf-hamburger" aria-hidden="true">
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
        </div>
      </button>
    </div>
  </header>

  <div class="bf-page-hero">
    <div class="bf-page-hero__eyebrow">GET IN TOUCH</div>
    <h1 class="bf-page-hero__title">CONTACT</h1>
    <div class="bf-page-hero__rule"></div>
  </div>

  <div class="bf-contact-grid">

    <!-- Left: Info -->
    <div class="bf-contact-info">

      <div class="bf-contact-block">
        <h2 class="bf-contact-block__label">ORDERS & SHIPPING</h2>
        <p class="bf-contact-block__val">
          For order questions, tracking, and delivery issues,
          email us with your order number and we'll respond within 24h.
        </p>
        <a href="mailto:orders@bledfake.com" class="bf-contact-link">orders@bledfake.com</a>
      </div>

      <div class="bf-contact-block">
        <h2 class="bf-contact-block__label">WHOLESALE & COLLABS</h2>
        <p class="bf-contact-block__val">
          We work with select stockists and artists.
          Send your proposal — we read every message.
        </p>
        <a href="mailto:collabs@bledfake.com" class="bf-contact-link">collabs@bledfake.com</a>
      </div>

      <div class="bf-contact-block">
        <h2 class="bf-contact-block__label">INSTAGRAM</h2>
        <a href="https://instagram.com/bledfake" target="_blank" rel="noopener noreferrer" class="bf-contact-link">@bledfake</a>
      </div>

      <div class="bf-contact-block">
        <h2 class="bf-contact-block__label">BASED IN</h2>
        <p class="bf-contact-block__val">TUNIS, TUNISIA</p>
        <p class="bf-contact-block__val" style="font-size:0.7rem; opacity:0.5; margin-top:0.3rem;">
          Shipping worldwide. Cash on delivery across Tunisia.
        </p>
      </div>

    </div>

    <!-- Right: Contact Form -->
    <div class="bf-contact-form-wrap">

      {% form 'contact', id: 'bf-contact-form', class: 'bf-checkout-form' %}

        {% if form.posted_successfully? %}
          <div class="bf-contact-success">
            <div style="font-family:var(--font-display); font-size:3rem; line-height:1;">MESSAGE<br>RECEIVED</div>
            <p style="font-family:var(--font-body); font-size:0.8rem; color:var(--bf-off-white-70); margin-top:1rem;">
              We'll get back to you within 24 hours.
            </p>
          </div>
        {% else %}

          {% if form.errors %}
            <div class="bf-contact-error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="bf-form-row">
            <div class="bf-form-group">
              <label class="bf-form-label" for="ContactForm-name">YOUR NAME *</label>
              <input
                type="text"
                id="ContactForm-name"
                name="contact[name]"
                class="bf-form-input"
                value="{{ form.name }}"
                autocomplete="name"
                placeholder="Aziz Ben Salem"
                required
              >
            </div>
            <div class="bf-form-group">
              <label class="bf-form-label" for="ContactForm-email">EMAIL ADDRESS *</label>
              <input
                type="email"
                id="ContactForm-email"
                name="contact[email]"
                class="bf-form-input"
                value="{{ form.email }}"
                autocomplete="email"
                placeholder="you@example.com"
                required
              >
            </div>
          </div>

          <div class="bf-form-group">
            <label class="bf-form-label" for="ContactForm-subject">SUBJECT</label>
            <select id="ContactForm-subject" name="contact[subject]" class="bf-form-select">
              <option value="Order question">Order question</option>
              <option value="Returns & exchanges">Returns & exchanges</option>
              <option value="Wholesale">Wholesale & stockists</option>
              <option value="Collaboration">Collaboration proposal</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="bf-form-group">
            <label class="bf-form-label" for="ContactForm-body">YOUR MESSAGE *</label>
            <textarea
              id="ContactForm-body"
              name="contact[body]"
              class="bf-form-input bf-form-textarea"
              placeholder="Write your message here..."
              rows="6"
              required
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="bf-checkout-submit-btn">
            <span>SEND MESSAGE</span>
            <span>→</span>
          </button>

        {% endif %}

      {% endform %}

    </div>

  </div>

  <footer class="bf-page-footer">
    <span>BLED FAKE // TUNIS // {{ 'now' | date: '%Y' }}</span>
    <span>WE READ EVERY MESSAGE</span>
  </footer>

</section>

{% schema %}
{
  "name": "BLED Contact",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "BLED Contact Page" }]
}
{% endschema %}
