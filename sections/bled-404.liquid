{% comment %}
  BLED FAKE — 404 Not Found Page (bled-404.liquid)
  On-brand brutalist error page.
{% endcomment %}

<section class="bf-page bf-404-page" aria-label="Page not found">
  <div class="bf-grain" aria-hidden="true"></div>

  <header class="bf-header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>
    <div class="bf-nav-right">
      <button class="bf-nav-btn" data-menu-open aria-label="Open menu">
        <span>MENU</span>
        <div class="bf-hamburger" aria-hidden="true">
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
        </div>
      </button>
    </div>
  </header>

  <div class="bf-404-content">
    <div class="bf-404-code" aria-hidden="true">404</div>
    <h1 class="bf-404-title">PAGE<br>NOT FOUND</h1>
    <p class="bf-404-body">
      This drop doesn't exist. Or maybe it sold out before you got here.
      Either way — this page is gone, like our restocks.
    </p>
    <div class="bf-page-cta-band" style="margin-top:3rem;">
      <a href="/collections/all" class="bf-page-cta-btn">
        <span>SHOP WHAT EXISTS</span>
        <span>→</span>
      </a>
      <a href="/" class="bf-page-cta-btn bf-page-cta-btn--outline">
        <span>GO HOME</span>
        <span>→</span>
      </a>
    </div>
  </div>

  <footer class="bf-page-footer">
    <span>BLED FAKE // TUNIS // {{ 'now' | date: '%Y' }}</span>
  </footer>

</section>

{% schema %}
{
  "name": "BLED 404",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "BLED 404 Page" }]
}
{% endschema %}
