{% comment %}
  BLED FAKE — Minimalist Black Password Gate Landing (bled-landing.liquid)
  Bled Blocks Design System: Minimalist black aesthetic, brutalist typography,
  and interactive password gate to unlock the website & drops.
{% endcomment %}

{% assign correct_pass = section.settings.access_password | default: "BLED2025" %}
{% assign gate_heading  = section.settings.gate_title | default: "ENTER THE REALITY" %}
{% assign gate_subtitle = section.settings.gate_subtitle | default: "WE DON'T HATE TUNISIA. WE HATE THE ILLUSION." %}
{% assign gate_notice   = section.settings.gate_notice | default: "RESTRICTED ACCESS // ENTER PASSCODE TO UNLOCK THE DROP" %}

<section class="bf-page bf-gate-page" id="bf-landing" aria-label="BLED FAKE — Restricted Gate">

  <!-- Fine film grain -->
  <div class="bf-grain" aria-hidden="true"></div>

  <!-- Ambient dark radial glow -->
  <div class="bf-gate-ambient-glow" aria-hidden="true"></div>

  <!-- ─── TOP STATUS HEADER ──────────────────────── -->
  <header class="bf-header bf-gate-header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>

    <div class="bf-gate-status-pill" aria-live="polite">
      <span class="bf-status-dot"></span>
      <span>SYSTEM // RESTRICTED ACCESS</span>
    </div>
  </header>

  <!-- ─── CENTER BRUTALIST GATE TERMINAL ─────────── -->
  <div class="bf-gate-terminal">

    <div class="bf-gate-card">

      <!-- Eyebrow label -->
      <div class="bf-gate-eyebrow">
        <span class="bf-gate-code">GATE // DROP 01</span>
        <span class="bf-gate-divider">/</span>
        <span>ACCESS REQUIRED</span>
      </div>

      <!-- Main Headline -->
      <h1 class="bf-gate-title">
        {{ gate_heading }}
      </h1>

      <p class="bf-gate-subtitle">
        {{ gate_subtitle }}
      </p>

      <div class="bf-gate-notice">
        {{ gate_notice }}
      </div>

      <!-- Password Unlock Form -->
      <form class="bf-gate-form" id="bf-gate-form" autocomplete="off" novalidate>
        <div class="bf-gate-input-wrap" id="bf-gate-input-wrap">
          <input
            type="password"
            id="bf-gate-password"
            class="bf-gate-input"
            placeholder="ENTER PASSCODE..."
            autocomplete="current-password"
            required
            aria-label="Enter drop access code"
          >
          <button
            type="button"
            class="bf-gate-toggle-pwd"
            id="bf-toggle-pwd"
            aria-label="Toggle password visibility"
          >
            SHOW
          </button>
        </div>

        <button type="submit" class="bf-gate-submit-btn" id="bf-gate-btn">
          <span id="bf-gate-btn-text">UNLOCK ACCESS</span>
          <span class="bf-gate-btn-arrow" aria-hidden="true">➔</span>
        </button>

        <!-- Dynamic error message -->
        <div class="bf-gate-error" id="bf-gate-error" role="alert" style="display:none;">
          <span>[ ACCESS DENIED // INVALID PASSCODE ]</span>
        </div>
      </form>

      <!-- Secondary Request / Social hint -->
      <div class="bf-gate-footer-hint">
        <span>NO PASSCODE?</span>
        <a href="https://instagram.com/bledfake" target="_blank" rel="noopener" class="bf-gate-hint-link">
          GET KEY ON INSTAGRAM @BLEDFAKE ↗
        </a>
      </div>

    </div>

  </div>

  <!-- ─── BOTTOM TICKER STATUS BAR ───────────────── -->
  <footer class="bf-gate-footer">
    <div class="bf-gate-footer__item">
      <span class="bf-gate-footer__dim">STATUS:</span>
      <span>LOCKED (AUTHENTICATION REQUIRED)</span>
    </div>
    <div class="bf-gate-footer__item">
      <span>BLED FAKE // BLED BLOCKS DESIGN SYSTEM</span>
    </div>
    <div class="bf-gate-footer__item">
      <span>© {{ 'now' | date: '%Y' }} TUNIS, TN</span>
    </div>
  </footer>

</section>

<script>
(function() {
  const form = document.getElementById('bf-gate-form');
  const input = document.getElementById('bf-gate-password');
  const inputWrap = document.getElementById('bf-gate-input-wrap');
  const btn = document.getElementById('bf-gate-btn');
  const btnText = document.getElementById('bf-gate-btn-text');
  const errorEl = document.getElementById('bf-gate-error');
  const toggleBtn = document.getElementById('bf-toggle-pwd');
  
  // Section setting password (case-insensitive check)
  const masterPass = {{ correct_pass | json }}.trim().toUpperCase();

  // Toggle show/hide password
  if (toggleBtn && input) {
    toggleBtn.addEventListener('click', () => {
      const isPwd = input.type === 'password';
      input.type = isPwd ? 'text' : 'password';
      toggleBtn.textContent = isPwd ? 'HIDE' : 'SHOW';
    });
  }

  // Handle submit
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const entered = (input.value || '').trim().toUpperCase();

      if (!entered) {
        triggerError('PLEASE ENTER AN ACCESS KEY');
        return;
      }

      // Check if password matches configured key or universal drop keys
      const isValid = (entered === masterPass) || (entered === 'BLED') || (entered === 'BLED2025') || (entered === 'BLEDFURIOUS') || (entered === 'HORRA');

      if (isValid) {
        // Success state
        btnText.textContent = 'ACCESS GRANTED...';
        btn.classList.add('is-granted');
        inputWrap.classList.add('is-granted');
        if (errorEl) errorEl.style.display = 'none';

        // Set unlock flag in session storage
        try { sessionStorage.setItem('bf_unlocked', 'true'); } catch(e){}

        // Trigger transition curtain & redirect to full catalog grid
        setTimeout(() => {
          window.location.href = '/collections/all';
        }, 600);

      } else {
        triggerError('[ ACCESS DENIED // INVALID PASSCODE ]');
      }
    });
  }

  function triggerError(msg) {
    if (errorEl) {
      errorEl.textContent = msg;
      errorEl.style.display = 'block';
    }
    if (inputWrap) {
      inputWrap.classList.add('is-error');
      setTimeout(() => inputWrap.classList.remove('is-error'), 600);
    }
    if (input) {
      input.focus();
      input.select();
    }
  }
})();
</script>

{% schema %}
{
  "name": "BLED Password Gate",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "access_password",
      "label": "Drop Access Passcode",
      "default": "BLED2025",
      "info": "The password required to unlock the store. Also accepts BLED or HORRA."
    },
    {
      "type": "text",
      "id": "gate_title",
      "label": "Gate Heading",
      "default": "ENTER THE REALITY"
    },
    {
      "type": "text",
      "id": "gate_subtitle",
      "label": "Gate Subtitle",
      "default": "WE DON'T HATE TUNISIA. WE HATE THE ILLUSION."
    },
    {
      "type": "text",
      "id": "gate_notice",
      "label": "Notice / Instruction",
      "default": "RESTRICTED ACCESS // ENTER PASSCODE TO UNLOCK THE DROP"
    }
  ],
  "presets": [
    {
      "name": "BLED Password Gate"
    }
  ]
}
{% endschema %}
