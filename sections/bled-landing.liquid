{% comment %}
  BLED FAKE — Landing Page Section (bled-landing.liquid)
  Full 100svh poster composition — one viewport, no scroll.
{% endcomment %}

{% assign cta_href = section.settings.cta_url | default: '/collections/all' %}
{% assign stmt1    = section.settings.statement_line1 | default: "WE DON'T HATE TUNISIA." %}
{% assign stmt2    = section.settings.statement_line2 | default: "WE HATE" %}
{% assign stmt_em  = section.settings.statement_emphasis | default: "THE ILLUSION." %}

<section class="bf-landing" id="bf-landing" aria-label="BLED FAKE — Welcome">

  <!-- Screenprint grain overlay -->
  <div class="bf-grain" aria-hidden="true"></div>

  <!-- Background geometric shapes -->
  <div class="bf-landing__shapes" aria-hidden="true">
    <div class="bf-shape bf-shape--1"></div>
    <div class="bf-shape bf-shape--2"></div>
  </div>

  <!-- ─── FLOATING HEADER ─────────────────────────── -->
  <header class="bf-landing__header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>

    <div class="bf-nav-right">
      <!-- Menu trigger -->
      <button
        class="bf-menu-trigger"
        data-menu-open
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="bf-main-menu"
      >
        <span class="bf-menu-trigger-label" aria-hidden="true">MENU</span>
        <div class="bf-hamburger" aria-hidden="true">
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
        </div>
      </button>
    </div>
  </header>

  <!-- ─── TUNISIAN CITY ILLUSTRATION (parallax) ───── -->
  <div class="bf-landing__city" aria-hidden="true" role="presentation">
    {%- render 'bled-city' -%}
  </div>

  <!-- ─── BF MASCOT (integrated into city scene) ──── -->
  <div class="bf-landing__mascot" aria-hidden="true" role="presentation">
    {%- render 'bled-mascot' -%}
  </div>

  <!-- ─── BRAND STATEMENT (asymmetric, street poster) -->
  <div class="bf-landing__statement" aria-label="{{ stmt1 }} {{ stmt2 }} {{ stmt_em }}">
    <span class="bf-statement__line">{{ stmt1 }}</span>
    <span class="bf-statement__line">
      {{- stmt2 -}}&nbsp;<span class="bf-statement__emphasis">{{- stmt_em -}}</span>
    </span>
  </div>

  <!-- ─── ENTER CTA (irregular geometric button) ───── -->
  <a
    href="{{ cta_href }}"
    class="bf-landing__cta"
    id="bf-enter-cta"
    aria-label="Enter the BLED FAKE store — Enter the Reality"
  >
    <span class="bf-cta__text" aria-hidden="true">
      <span class="bf-cta__line">ENTER</span>
      <span class="bf-cta__line">THE REALITY</span>
    </span>
    <span class="bf-cta__arrow" aria-hidden="true">→</span>
  </a>

</section>

{% schema %}
{
  "name": "BLED Landing",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "statement_line1",
      "label": "Statement — Line 1",
      "default": "WE DON'T HATE TUNISIA."
    },
    {
      "type": "text",
      "id": "statement_line2",
      "label": "Statement — Line 2 (before emphasis)",
      "default": "WE HATE"
    },
    {
      "type": "text",
      "id": "statement_emphasis",
      "label": "Statement — Emphasis phrase",
      "default": "THE ILLUSION."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "BLED Landing Page"
    }
  ]
}
{% endschema %}
