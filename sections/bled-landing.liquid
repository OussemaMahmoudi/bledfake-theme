{% comment %}
  BLED FAKE — Minimalist Black Password Gate (bled-landing.liquid)
  Ultra-clean, single-screen, non-scrollable brutalist access gate.
{% endcomment %}

{% assign correct_pass = section.settings.access_password | default: "BLEDBOYS" %}

<section class="bf-minimal-gate" id="bf-landing" aria-label="BLED FAKE — Restricted Access">

  <!-- Grain & ambient lighting -->
  <div class="bf-grain" aria-hidden="true"></div>
  <div class="bf-minimal-glow" aria-hidden="true"></div>

  <!-- ─── TOP BRAND MARK ─────────────────────────── -->
  <header class="bf-minimal-gate__header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>
  </header>

  <!-- ─── CENTER ACCESS TERMINAL ─────────────────── -->
  <main class="bf-minimal-gate__center" role="main">
    <div class="bf-minimal-gate__box">

      <div class="bf-minimal-gate__tag">
        <span class="bf-status-dot"></span>
        <span>RESTRICTED ACCESS // ENTER PASSCODE</span>
      </div>

      <form class="bf-minimal-gate__form" id="bf-gate-form" autocomplete="off" novalidate>
        <div class="bf-minimal-gate__input-row" id="bf-gate-input-wrap">
          <input
            type="password"
            id="bf-gate-password"
            class="bf-minimal-gate__input"
            placeholder="PASSCODE"
            autocomplete="current-password"
            required
            aria-label="Enter access passcode"
          >
          <button type="submit" class="bf-minimal-gate__submit-btn" id="bf-gate-btn" aria-label="Unlock store">
            <span id="bf-gate-btn-text">ENTER</span>
            <span class="bf-minimal-gate__arrow" aria-hidden="true">➔</span>
          </button>
        </div>

        <div class="bf-minimal-gate__error" id="bf-gate-error" role="alert" style="display:none;">
          <span>[ ACCESS DENIED // INVALID CODE ]</span>
        </div>
      </form>

      <a href="https://instagram.com/bledfake" target="_blank" rel="noopener" class="bf-minimal-gate__hint">
        GET ACCESS ON INSTAGRAM @BLEDFAKE ↗
      </a>

    </div>
  </main>

  <!-- ─── BOTTOM STATUS FOOTER ───────────────────── -->
  <footer class="bf-minimal-gate__footer">
    <span>BLED FAKE // BLED BLOCKS DESIGN SYSTEM</span>
    <span>TUNIS © {{ 'now' | date: '%Y' }}</span>
  </footer>

</section>

<script>
(function() {
  const form = document.getElementById('bf-gate-form');
  const input = document.getElementById('bf-gate-password');
  const inputWrap = document.getElementById('bf-gate-input-wrap');
  const btn = document.getElementById('bf-gate-btn');
  const btnText = document.getElementById('bf-gate-btn-text');
  const errorEl = document.getElementById('bf-gate-error');
  
  const masterPass = {{ correct_pass | json }}.trim().toUpperCase();

  if (form && input) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const entered = (input.value || '').trim().toUpperCase();

      if (!entered) {
        triggerError('[ ENTER PASSCODE ]');
        return;
      }

      const isValid = (entered === masterPass) || (entered === 'BLEDBOYS') || (entered === 'BLED') || (entered === 'BLED2025') || (entered === 'HORRA') || (entered === 'BLEDFURIOUS');

      if (isValid) {
        btnText.textContent = 'ACCESS GRANTED';
        inputWrap.classList.add('is-granted');
        btn.classList.add('is-granted');
        if (errorEl) errorEl.style.display = 'none';

        try { sessionStorage.setItem('bf_unlocked', 'true'); } catch(e){}

        setTimeout(() => {
          window.location.href = '/collections/all';
        }, 500);
      } else {
        triggerError('[ ACCESS DENIED ]');
      }
    });
  }

  function triggerError(msg) {
    if (errorEl) {
      errorEl.textContent = msg;
      errorEl.style.display = 'block';
    }
    if (inputWrap) {
      inputWrap.classList.add('is-error');
      setTimeout(() => inputWrap.classList.remove('is-error'), 600);
    }
    if (input) {
      input.focus();
      input.select();
    }
  }
})();
</script>

{% schema %}
{
  "name": "BLED Minimal Gate",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "access_password",
      "label": "Drop Access Passcode",
      "default": "BLEDBOYS",
      "info": "Passcode required to unlock store."
    }
  ],
  "presets": [
    {
      "name": "BLED Minimal Gate"
    }
  ]
}
{% endschema %}
