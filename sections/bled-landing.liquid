{% comment %}
  BLED FAKE — Clean Brutalist Landing Hero (bled-landing.liquid)
{% endcomment %}

{% assign cta_href = section.settings.cta_url | default: '/collections/all' %}
{% assign stmt1    = section.settings.statement_line1 | default: "WE DON'T HATE TUNISIA." %}
{% assign stmt2    = section.settings.statement_line2 | default: "WE HATE" %}
{% assign stmt_em  = section.settings.statement_emphasis | default: "THE ILLUSION." %}

<section class="bf-landing" id="bf-landing" aria-label="BLED FAKE — Welcome">

  <!-- Grain overlay -->
  <div class="bf-grain" aria-hidden="true"></div>

  <!-- ─── TOP HEADER ─────────────────────────────── -->
  <header class="bf-header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>

    <div class="bf-nav-right">
      <button class="bf-nav-btn" data-menu-open aria-label="Open navigation menu">
        <span>MENU</span>
        <div class="bf-hamburger" aria-hidden="true">
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
        </div>
      </button>
    </div>
  </header>

  <!-- ─── TUNISIAN CITY PARALLAX BACKGROUND ──────── -->
  <div class="bf-landing__city" aria-hidden="true" role="presentation">
    {%- render 'bled-city' -%}
  </div>

  <!-- ─── MASCOT OVERLAY ──────────────────────────── -->
  <div class="bf-landing__mascot" aria-hidden="true" role="presentation">
    {%- render 'bled-mascot' -%}
  </div>

  <!-- ─── EDITORIAL HERO CONTENT ─────────────────── -->
  <div class="bf-landing__content">
    <div class="bf-landing__tag">UNDERGROUND STREETWEAR // TUNISIA</div>

    <div class="bf-landing__statement">
      <h1 class="bf-statement__line-1">{{ stmt1 }}</h1>
      <div class="bf-statement__line-2">
        {{ stmt2 }} <span class="bf-statement__emphasis">{{ stmt_em }}</span>
      </div>
    </div>

    <a href="{{ cta_href }}" class="bf-landing__cta" id="bf-enter-cta" aria-label="Enter store">
      <span>ENTER THE REALITY</span>
      <span class="bf-cta__arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <!-- ─── BOTTOM TICKER ──────────────────────────── -->
  <footer class="bf-landing__footer">
    <span>BLED FAKE // BLED BLOCKS DESIGN SYSTEM</span>
    <span>LIMITED UNDERGROUND DROPS</span>
    <span>© {{ 'now' | date: '%Y' }} TUNIS</span>
  </footer>

</section>

{% schema %}
{
  "name": "BLED Landing",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "statement_line1",
      "label": "Statement — Line 1",
      "default": "WE DON'T HATE TUNISIA."
    },
    {
      "type": "text",
      "id": "statement_line2",
      "label": "Statement — Line 2 (before emphasis)",
      "default": "WE HATE"
    },
    {
      "type": "text",
      "id": "statement_emphasis",
      "label": "Statement — Emphasis phrase",
      "default": "THE ILLUSION."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "BLED Landing Page"
    }
  ]
}
{% endschema %}
