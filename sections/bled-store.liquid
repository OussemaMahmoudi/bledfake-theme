{% comment %}
  BLED FAKE — Store & Collection Section (bled-store.liquid)
  Brutalist storefront — Shopify-connected product gallery.
  Supports: collection filter tabs, multi-image arrows, variant selection, add to cart, buy now.
{% endcomment %}

{% if collection %}
  {% assign product_list = collection.products %}
{% elsif product %}
  {% assign product_list = collections.all.products %}
{% else %}
  {% assign product_list = collections.all.products %}
{% endif %}

{% assign product_count = product_list.size %}

{% if product %}
  {% assign current_product = product %}
  {% assign current_index = 0 %}
  {% for p in product_list %}
    {% if p.id == product.id %}
      {% assign current_index = forloop.index0 %}
    {% endif %}
  {% endfor %}
{% else %}
  {% assign current_product = product_list.first %}
  {% assign current_index = 0 %}
{% endif %}

{% assign current_variant = current_product.selected_or_first_available_variant %}

{% comment %} Build the media/images list for the current product {% endcomment %}
{% assign prod_media = current_product.media %}
{% if prod_media == blank or prod_media.size == 0 %}
  {% assign prod_media = current_product.images %}
{% endif %}

{% comment %} Build JSON images array for inline data attribute {% endcomment %}
{% capture prod_images_json %}[{% for m in prod_media %}{{ m.preview_image | default: m | image_url: width: 800 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endcapture %}

<script>
window.bfProducts = [
  {%- for p in product_list -%}
  {%- assign p_media = p.media -%}
  {%- if p_media == blank or p_media.size == 0 -%}{%- assign p_media = p.images -%}{%- endif -%}
  {
    "id":            {{ p.id }},
    "handle":        {{ p.handle | json }},
    "title":         {{ p.title | json }},
    "url":           {{ p.url | json }},
    "description":   {{ p.description | strip_html | truncate: 300 | json }},
    "price":         {{ p.price }},
    "compare_at_price": {{ p.compare_at_price | default: 0 }},
    "available":     {{ p.available }},
    "featured_image": {{ p.featured_image | image_url: width: 800 | json }},
    "images": [
      {%- for m in p_media -%}
      {{ m.preview_image | default: m | image_url: width: 800 | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "variants": [
      {%- for v in p.variants -%}
      {
        "id":              {{ v.id }},
        "title":           {{ v.title | json }},
        "price":           {{ v.price }},
        "compare_at_price": {{ v.compare_at_price | default: 0 }},
        "available":       {{ v.available }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];
</script>

<section class="bf-store" id="bf-store" aria-label="BLED FAKE Store">

  <div class="bf-grain" aria-hidden="true"></div>

  <!-- ─── TOP HEADER ─────────────────────────────── -->
  <header class="bf-header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>

    <div class="bf-nav-right">
      <button class="bf-nav-btn" data-cart-open aria-label="Open cart">
        <span>BAG</span>
        <span class="bf-cart-badge-count bf-cart-count" aria-live="polite">{{ cart.item_count }}</span>
      </button>

      <button class="bf-nav-btn" data-menu-open aria-label="Open menu">
        <span>MENU</span>
        <div class="bf-hamburger" aria-hidden="true">
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
        </div>
      </button>
    </div>
  </header>

  <!-- ─── COLLECTION TABS (Real Shopify Collections) ─ -->
  <nav class="bf-collection-bar" aria-label="Collection filter">
    {% assign current_col_handle = collection.handle | default: 'all' %}

    <a href="/collections/all"
       class="bf-collection-tab{% if current_col_handle == 'all' or collection == blank %} is-active{% endif %}"
       data-collection="all"
    >ALL DROPS</a>

    {% for col in collections %}
      {% unless col.handle == 'frontpage' or col.handle == 'all' %}
        {% if col.all_products_count > 0 or col.products_count > 0 %}
          <a
            href="{{ col.url }}"
            class="bf-collection-tab{% if current_col_handle == col.handle %} is-active{% endif %}"
            data-collection="{{ col.handle }}"
          >
            {{ col.title | upcase }}
          </a>
        {% endif %}
      {% endunless %}
    {% endfor %}
  </nav>

  <!-- ─── MAIN GALLERY VIEWPORT ──────────────────── -->
  <div class="bf-gallery-viewport">

    <!-- Previous Product Arrow -->
    <button
      class="bf-gallery-nav-btn bf-gallery-nav-btn--prev"
      id="prev-btn"
      aria-label="Previous product"
      {% if product_count <= 1 %}disabled{% endif %}
    >
      <div class="bf-nav-box">◄</div>
      <span class="bf-nav-label">PREV</span>
    </button>

    <!-- Product Stage Grid -->
    <div
      class="bf-product-stage-grid"
      id="product-display"
      data-current-index="{{ current_index }}"
      data-product-count="{{ product_count }}"
    >

      {% if current_product %}

      <!-- Left: Garment Stage with Glow & Scrollable Track -->
        <div class="bf-garment-stage">
          <div class="bf-garment-glow" aria-hidden="true"></div>

          <!-- Scrollable Garment Artwork Track -->
          <div class="bf-garment-scroll-track" id="product-media-track" role="region" aria-label="Product media gallery">
            {% if prod_media.size > 0 %}
              {% for m in prod_media %}
                {% assign img = m.preview_image | default: m %}
                <div class="bf-garment-slide" data-media-index="{{ forloop.index0 }}">
                  <img
                    class="bf-product-image"
                    src="{{ img | image_url: width: 1000 }}"
                    srcset="{{ img | image_url: width: 500 }} 500w,
                            {{ img | image_url: width: 1000 }} 1000w,
                            {{ img | image_url: width: 1600 }} 1600w"
                    sizes="(max-width: 768px) 95vw, 55vw"
                    alt="{{ img.alt | default: current_product.title | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    decoding="async"
                  >
                </div>
              {% endfor %}
            {% elsif current_product.featured_image %}
              <div class="bf-garment-slide" data-media-index="0">
                <img
                  class="bf-product-image"
                  src="{{ current_product.featured_image | image_url: width: 1000 }}"
                  alt="{{ current_product.title | escape }}"
                  loading="eager"
                >
              </div>
            {% else %}
              <div class="bf-garment-slide" data-media-index="0">
                <div class="bf-product-image-placeholder" aria-label="{{ current_product.title | escape }}">
                  <svg viewBox="0 0 320 380" xmlns="http://www.w3.org/2000/svg" width="320">
                    <polygon points="95,45 130,70 190,70 225,45 305,100 275,175 240,155 240,360 80,360 80,155 45,175 15,100" fill="#121210" stroke="#2a2a26" stroke-width="2"/>
                    <path d="M 130,70 Q 160,95 190,70" fill="none" stroke="#3a3a34" stroke-width="2.5"/>
                    <rect x="110" y="140" width="100" height="14" fill="#F1EEE6" opacity="0.85"/>
                    <rect x="125" y="162" width="70" height="8" fill="#F1EEE6" opacity="0.6"/>
                  </svg>
                </div>
              </div>
            {% endif %}
          </div>

          <!-- Image counter dots -->
          {% if prod_media.size > 1 %}
            <div class="bf-media-dots" aria-hidden="true" id="bf-media-dots">
              {% for m in prod_media %}
                <button
                  type="button"
                  class="bf-media-dot{% if forloop.first %} is-active{% endif %}"
                  data-slide-index="{{ forloop.index0 }}"
                  aria-label="View slide {{ forloop.index }}"
                ></button>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <!-- Right: Product Info Card -->
        <div class="bf-product-info-card" itemscope itemtype="https://schema.org/Product">

          <h1 class="bf-product-title" id="product-name" itemprop="name">
            {{ current_product.title | upcase }}
          </h1>

          <div class="bf-product-price-row" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
            <span class="bf-product-price-val" id="product-price" itemprop="price" content="{{ current_variant.price | divided_by: 100.0 }}">
              {{ current_variant.price | money }}
            </span>
            <span
              class="bf-product-price-compare"
              id="product-compare-price"
              {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}
            >
              {{ current_variant.compare_at_price | money }}
            </span>
            <meta itemprop="priceCurrency" content="{{ shop.currency }}">
          </div>

          <!-- Product description -->
          <div
            class="bf-product-description"
            id="product-description"
            {% if current_product.description == blank %}style="display:none;"{% endif %}
          >
            {{ current_product.description | strip_html }}
          </div>

          <!-- Add to Cart & Buy Now Form -->
          <form class="bf-add-cart-form" action="/cart/add" method="post" id="bf-add-form" novalidate>
            <input type="hidden" name="id" id="selected-variant-id" value="{{ current_variant.id }}">

            <div class="bf-size-group">
              <span class="bf-size-group-label">
                SELECT SIZE
                {% unless current_product.has_only_default_variant %}
                  <a href="{{ current_product.url }}#size-guide" class="bf-size-guide-link" target="_blank" rel="noopener">SIZE GUIDE ↗</a>
                {% endunless %}
              </span>
              <div class="bf-size-pills" id="bf-size-pills" role="group" aria-label="Available sizes">
                {% if current_product.variants.size > 1 %}
                  {% for variant in current_product.variants %}
                    <button
                      type="button"
                      class="bf-size-pill{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-disabled{% endunless %}"
                      data-variant-id="{{ variant.id }}"
                      data-price="{{ variant.price }}"
                      data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                      data-available="{{ variant.available }}"
                      {% unless variant.available %}disabled aria-disabled="true" title="Sold out"{% endunless %}
                    >
                      {{ variant.title }}
                    </button>
                  {% endfor %}
                {% else %}
                  <button
                    type="button"
                    class="bf-size-pill is-selected"
                    data-variant-id="{{ current_variant.id }}"
                    data-price="{{ current_variant.price }}"
                    data-compare-price="{{ current_variant.compare_at_price | default: 0 }}"
                    data-available="{{ current_variant.available }}"
                  >
                    {% if current_variant.title != 'Default Title' %}{{ current_variant.title }}{% else %}ONE SIZE{% endif %}
                  </button>
                {% endif %}
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="bf-product-actions">
              <button
                type="submit"
                class="bf-cart-submit-btn"
                id="add-to-cart-btn"
                {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
              >
                <span id="btn-text">
                  {% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
                </span>
                <span aria-hidden="true">➔</span>
              </button>

              <button
                type="button"
                class="bf-buy-now-btn"
                id="buy-now-btn"
                {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
              >
                <span id="buy-now-text">BUY IT NOW</span>
              </button>
            </div>
          </form>

        </div>

      {% else %}
        <div style="grid-column:1/-1; text-align:center; padding:6rem 2rem;">
          <p style="font-family:var(--font-display); font-size:2.5rem; color:var(--bf-off-white-40);">
            NO PRODUCTS FOUND IN THIS DROP
          </p>
        </div>
      {% endif %}

    </div>

    <!-- Next Product Arrow -->
    <button
      class="bf-gallery-nav-btn bf-gallery-nav-btn--next"
      id="next-btn"
      aria-label="Next product"
      {% if product_count <= 1 %}disabled{% endif %}
    >
      <div class="bf-nav-box">►</div>
      <span class="bf-nav-label">NEXT</span>
    </button>

  </div>

  <!-- ─── BOTTOM TICKER ──────────────────────────── -->
  <div class="bf-gallery-status-bar" aria-hidden="true">
    <span>TUNISIAN UNDERGROUND STREET CULTURE</span>
    <span>BLEDFAKE 2026</span>
  </div>

</section>

{% schema %}
{
  "name": "BLED Store",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "BLED Store Page"
    }
  ]
}
{% endschema %}
