{% comment %}
  BLED FAKE — Experimental Store Section (bled-store.liquid)
  Shows one product at a time. No grid. No cards.
  Navigation: irregular arrow buttons (prev/next).
  Right: vertical category rail.
  Shopify product data passed to JS via window.bfProducts.
{% endcomment %}

{% comment %} ── Resolve product list ───────────────────────────────── {% endcomment %}
{% if collection %}
  {% assign product_list = collection.products %}
{% elsif product %}
  {% assign product_list = collections.all.products %}
{% else %}
  {% assign product_list = collections.all.products %}
{% endif %}

{% comment %} ── Determine current product ───────────────────────────── {% endcomment %}
{% if product %}
  {% assign current_product = product %}
  {% assign current_index = 0 %}
  {% for p in product_list %}
    {% if p.id == product.id %}
      {% assign current_index = forloop.index0 %}
    {% endif %}
  {% endfor %}
{% else %}
  {% assign current_product = product_list.first %}
  {% assign current_index = 0 %}
{% endif %}

{% comment %} ── Build JS products array ─────────────────────────────── {% endcomment %}
<script>
window.bfProducts = [
  {%- for p in product_list -%}
  {
    "id":            {{ p.id }},
    "title":         {{ p.title | json }},
    "url":           {{ p.url | json }},
    "price":         {{ p.price }},
    "available":     {{ p.available }},
    "featured_image":{{ p.featured_image | image_url: width: 800 | json }},
    "variants": [
      {%- for v in p.variants -%}
      {
        "id":        {{ v.id }},
        "title":     {{ v.title | json }},
        "price":     {{ v.price }},
        "available": {{ v.available }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];
</script>

<section class="bf-store" id="bf-store" aria-label="BLED FAKE Store">

  <!-- Grain overlay -->
  <div class="bf-grain" aria-hidden="true"></div>

  <!-- ─── FIXED HEADER ──────────────────────────────────── -->
  <header class="bf-store__header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>

    <div class="bf-nav-right">
      <!-- Cart trigger -->
      <button
        class="bf-cart-trigger"
        data-cart-open
        aria-label="Open shopping cart"
      >
        <span class="bf-cart-trigger-label" aria-hidden="true">CART</span>
        <span class="bf-cart-count-badge bf-display">
          CART <span class="bf-cart-count"></span>
        </span>
      </button>

      <!-- Menu trigger -->
      <button
        class="bf-menu-trigger"
        data-menu-open
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="bf-main-menu"
      >
        <span class="bf-menu-trigger-label" aria-hidden="true">MENU</span>
        <div class="bf-hamburger" aria-hidden="true">
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
        </div>
      </button>
    </div>
  </header>

  <!-- ─── PRODUCT COUNTER (background number + name) ──── -->
  <div class="bf-store__counter" aria-hidden="true">
    <span class="bf-counter__num">
      {{ current_index | plus: 1 | prepend: '000' | slice: -3, 3 }}
    </span>
    <span class="bf-counter__name">
      {% if current_product %}{{ current_product.title | upcase }}{% else %}NO PRODUCTS{% endif %}
    </span>
  </div>

  <!-- ─── MAIN PRODUCT AREA ─────────────────────────────── -->
  <div class="bf-store__product-area">

    <!-- ◄ PREV BUTTON -->
    <button
      class="bf-arrow bf-arrow--prev"
      aria-label="Previous product"
      {% if product_list.size <= 1 %}disabled{% endif %}
    >
      <div class="bf-arrow__icon" aria-hidden="true">◄</div>
      <span class="bf-arrow__label">PREV</span>
    </button>

    <!-- PRODUCT DISPLAY — the focal piece -->
    <div
      class="bf-product-display"
      data-current-index="{{ current_index }}"
      aria-live="polite"
      aria-label="Currently viewing: {{ current_product.title | default: 'No product' }}"
    >
      {% if current_product %}

        <!-- Floating product stage with ambient white glow (no box frame) -->
        <div class="bf-product-stage">
          <div class="bf-product-glow" aria-hidden="true"></div>
          <div class="bf-product-image-wrap">
            {% if current_product.featured_image %}
              <img
                class="bf-product-image"
                src="{{ current_product.featured_image | image_url: width: 800 }}"
                srcset="{{ current_product.featured_image | image_url: width: 400 }} 400w,
                        {{ current_product.featured_image | image_url: width: 800 }} 800w"
                sizes="(max-width: 767px) 80vw, 35vw"
                alt="{{ current_product.featured_image.alt | default: current_product.title | escape }}"
                loading="eager"
                width="{{ current_product.featured_image.width }}"
                height="{{ current_product.featured_image.height }}"
              >
            {% else %}
              <!-- Transparent streetwear silhouette placeholder -->
              <div class="bf-product-image-placeholder" aria-label="{{ current_product.title | escape }}">
                <svg viewBox="0 0 300 360" xmlns="http://www.w3.org/2000/svg" width="240" aria-hidden="true">
                  <!-- Oversized streetwear tee silhouette -->
                  <polygon points="90,30 120,60 180,60 210,30 280,75 250,140 215,120 215,340 85,340 85,120 50,140 20,75" fill="#121210" stroke="#2a2a26" stroke-width="2"/>
                  <!-- Collar rib -->
                  <path d="M 120,60 Q 150,78 180,60" fill="none" stroke="#3a3a34" stroke-width="3"/>
                  <!-- Chest graphic: BLED FAKE stencil -->
                  <rect x="105" y="140" width="90" height="12" fill="#F1EEE6" opacity="0.85"/>
                  <rect x="120" y="160" width="60" height="8" fill="#F1EEE6" opacity="0.6"/>
                  <rect x="135" y="175" width="30" height="6" fill="#F1EEE6" opacity="0.4"/>
                </svg>
              </div>
            {% endif %}

            {% if current_product.compare_at_price > current_product.price %}
              <span class="bf-product-badge">SALE</span>
            {% endif %}
          </div>
        </div>
        <!-- /bf-product-stage -->

        <!-- Product info panel -->
        <div class="bf-product-info-panel" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
          <meta itemprop="priceCurrency" content="{{ shop.currency }}">
          <meta itemprop="price" content="{{ current_product.selected_or_first_available_variant.price | divided_by: 100.0 }}">

          <div class="bf-product-price-wrap">
            <span class="bf-product-price bf-display">
              {{ current_product.selected_or_first_available_variant.price | money }}
            </span>

            {% if current_product.compare_at_price > current_product.price %}
              <span class="bf-product-price--compare">
                {{ current_product.compare_at_price | money }}
              </span>
            {% endif %}
          </div>

          <!-- Variant / Size selector -->
          <form
            class="bf-add-cart-form"
            action="/cart/add"
            method="post"
            aria-label="Add {{ current_product.title | escape }} to cart"
          >
            <div class="bf-size-section">
              <span class="bf-size-label">SELECT SIZE</span>
              <div class="bf-size-selector" role="group" aria-label="Select size">
                {% if current_product.variants.size > 1 %}
                  {% for variant in current_product.variants %}
                    <label class="bf-size-option{% if variant == current_product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} bf-size-option--sold-out{% endunless %}">
                      <input
                        type="radio"
                        name="id"
                        value="{{ variant.id }}"
                        class="visually-hidden"
                        {% if variant == current_product.selected_or_first_available_variant %}checked{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                        aria-label="{{ variant.title }}"
                      >
                      {{ variant.title }}
                    </label>
                  {% endfor %}
                {% else %}
                  <!-- Standard streetwear size options -->
                  {% assign sizes = "S,M,L,XL" | split: "," %}
                  {% for s in sizes %}
                    <label class="bf-size-option{% if forloop.first %} selected{% endif %}">
                      <input
                        type="radio"
                        name="size_display"
                        value="{{ s }}"
                        class="visually-hidden"
                        {% if forloop.first %}checked{% endif %}
                        aria-label="Size {{ s }}"
                      >
                      {{ s }}
                    </label>
                  {% endfor %}
                  <input type="hidden" name="id" value="{{ current_product.variants.first.id }}">
                {% endif %}
              </div>
            </div>

            <button
              type="submit"
              class="bf-add-cart-btn"
              {% unless current_product.available %}disabled{% endunless %}
            >
              {% if current_product.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
            </button>
          </form>

        </div>
        <!-- /bf-product-info-panel -->

      {% else %}
        <!-- Empty collection state -->
        <div class="bf-product-stage" style="opacity:0.3;">
          <p class="bf-display bf-display-md" style="color:var(--bf-off-white);padding:2rem;text-align:center">
            NO PRODUCTS<br>YET
          </p>
        </div>
      {% endif %}

    </div>
    <!-- /bf-product-display -->

    <!-- ► NEXT BUTTON -->
    <button
      class="bf-arrow bf-arrow--next"
      aria-label="Next product"
      {% if product_list.size <= 1 %}disabled{% endif %}
    >
      <div class="bf-arrow__icon" aria-hidden="true">►</div>
      <span class="bf-arrow__label">NEXT</span>
    </button>

  </div>
  <!-- /bf-store__product-area -->

  <!-- ─── VERTICAL CATEGORY RAIL (right side) ──────── -->
  <nav class="bf-category-rail" aria-label="Product categories">
    {% assign all_collections = collections | where: 'title', '!=', 'Frontpage' %}
    {% for col in all_collections limit: 8 %}
      <a
        href="{{ col.url }}"
        class="bf-rail-item{% if collection and collection.id == col.id %} is-active{% endif %}"
        aria-label="{{ col.title }}"
        aria-current="{% if collection and collection.id == col.id %}page{% else %}false{% endif %}"
      >
        {{ col.title | upcase | truncate: 10, '' }}
      </a>
    {% else %}
      <!-- Fallback rail items when no named collections exist -->
      <a href="/collections/bledfake"          class="bf-rail-item is-active">BLEDFAKE</a>
      <a href="/collections/bledhorra"         class="bf-rail-item">BLEDHORRA</a>
      <a href="/collections/comeback-tommorow" class="bf-rail-item">COMEBACK TOMMOROW</a>
    {% endfor %}
  </nav>

</section>

{% schema %}
{
  "name": "BLED Store",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "BLED Store Page"
    }
  ]
}
{% endschema %}
