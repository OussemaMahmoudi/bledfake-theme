{% comment %}
  BLED FAKE — Store & Collection Section (bled-store.liquid)
  Fully integrated with live Shopify backend (real collections, multi-image views, dynamic variants)
{% endcomment %}

{% if collection %}
  {% assign product_list = collection.products %}
{% elsif product %}
  {% assign product_list = collections.all.products %}
{% else %}
  {% assign product_list = collections.all.products %}
{% endif %}

{% if product %}
  {% assign current_product = product %}
  {% assign current_index = 0 %}
  {% for p in product_list %}
    {% if p.id == product.id %}
      {% assign current_index = forloop.index0 %}
    {% endif %}
  {% endfor %}
{% else %}
  {% assign current_product = product_list.first %}
  {% assign current_index = 0 %}
{% endif %}

{% assign current_variant = current_product.selected_or_first_available_variant %}

<script>
window.bfProducts = [
  {%- for p in product_list -%}
  {
    "id":            {{ p.id }},
    "title":         {{ p.title | json }},
    "url":           {{ p.url | json }},
    "price":         {{ p.price }},
    "compare_at_price": {{ p.compare_at_price | default: 0 }},
    "available":     {{ p.available }},
    "featured_image":{{ p.featured_image | image_url: width: 800 | json }},
    "images": [
      {%- for img in p.images -%}
      {{ img | image_url: width: 800 | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "variants": [
      {%- for v in p.variants -%}
      {
        "id":        {{ v.id }},
        "title":     {{ v.title | json }},
        "price":     {{ v.price }},
        "compare_at_price": {{ v.compare_at_price | default: 0 }},
        "available": {{ v.available }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];
</script>

<section class="bf-store" id="bf-store" aria-label="BLED FAKE Store">

  <!-- Grain overlay -->
  <div class="bf-grain" aria-hidden="true"></div>

  <!-- ─── TOP HEADER ─────────────────────────────── -->
  <header class="bf-header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>

    <div class="bf-nav-right">
      <button class="bf-nav-btn" data-cart-open aria-label="Open cart drawer">
        <span>CART</span>
        <span class="bf-cart-badge-count bf-cart-count">{{ cart.item_count }}</span>
      </button>

      <button class="bf-nav-btn" data-menu-open aria-label="Open menu">
        <span>MENU</span>
        <div class="bf-hamburger" aria-hidden="true">
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
        </div>
      </button>
    </div>
  </header>

  <!-- ─── REAL SHOPIFY COLLECTION TABS ───────────── -->
  <nav class="bf-collection-bar" aria-label="Collections filter">
    {% assign current_col_handle = collection.handle | default: 'all' %}
    
    <a href="/collections/all" class="bf-collection-tab{% if current_col_handle == 'all' or collection == blank %} is-active{% endif %}">
      ALL DROPS
    </a>

    {% for col in collections %}
      {% unless col.handle == 'frontpage' or col.handle == 'all' %}
        {% if col.all_products_count > 0 or col.products_count > 0 %}
          <a href="{{ col.url }}" class="bf-collection-tab{% if current_col_handle == col.handle %} is-active{% endif %}">
            {{ col.title | upcase }}
          </a>
        {% endif %}
      {% endunless %}
    {% endfor %}
  </nav>

  <!-- ─── MAIN GALLERY VIEWPORT ──────────────────── -->
  <div class="bf-gallery-viewport">

    <!-- Previous Arrow -->
    <button class="bf-gallery-nav-btn bf-gallery-nav-btn--prev" id="prev-btn" aria-label="Previous product" {% if product_list.size <= 1 %}disabled{% endif %}>
      <div class="bf-nav-box">◄</div>
      <span class="bf-nav-label">PREV</span>
    </button>

    <!-- Product Stage Grid -->
    <div class="bf-product-stage-grid" id="product-display" data-current-index="{{ current_index }}">

      {% if current_product %}

        <!-- Left: Floating Garment Stage with Ambient White Glow & Multi-View Switcher -->
        <div class="bf-garment-stage">
          <div class="bf-garment-glow" aria-hidden="true"></div>
          
          <div class="bf-garment-artwork" id="product-art-container">
            {% if current_product.featured_image %}
              <img
                class="bf-product-image"
                id="main-product-img"
                src="{{ current_product.featured_image | image_url: width: 800 }}"
                srcset="{{ current_product.featured_image | image_url: width: 400 }} 400w,
                        {{ current_product.featured_image | image_url: width: 800 }} 800w"
                sizes="(max-width: 900px) 90vw, 45vw"
                alt="{{ current_product.featured_image.alt | default: current_product.title | escape }}"
                loading="eager"
              >
            {% else %}
              <div class="bf-product-image-placeholder" aria-label="{{ current_product.title | escape }}">
                <svg viewBox="0 0 320 380" xmlns="http://www.w3.org/2000/svg" width="280">
                  <polygon points="95,45 130,70 190,70 225,45 305,100 275,175 240,155 240,360 80,360 80,155 45,175 15,100" fill="#121210" stroke="#2a2a26" stroke-width="2"/>
                  <path d="M 130,70 Q 160,95 190,70" fill="none" stroke="#3a3a34" stroke-width="2.5"/>
                  <rect x="110" y="140" width="100" height="14" fill="#F1EEE6" opacity="0.85"/>
                  <rect x="125" y="162" width="70" height="8" fill="#F1EEE6" opacity="0.6"/>
                </svg>
              </div>
            {% endif %}
          </div>

          <!-- Multi-Image Front / Back View Switcher -->
          <div class="bf-view-switcher" id="bf-view-switcher" role="tablist" aria-label="Product angles"{% if current_product.images.size <= 1 %} style="display:none;"{% endif %}>
            {% for img in current_product.images %}
              <button
                type="button"
                class="bf-view-btn{% if forloop.first %} is-active{% endif %}"
                data-img-src="{{ img | image_url: width: 800 }}"
                aria-label="View {{ forloop.index }}"
              >
                {% if forloop.index == 1 %}
                  FRONT
                {% elsif forloop.index == 2 %}
                  BACK
                {% else %}
                  VIEW {{ forloop.index }}
                {% endif %}
              </button>
            {% endfor %}
          </div>
        </div>

        <!-- Right: Clean Product Info Card -->
        <div class="bf-product-info-card" itemscope itemtype="https://schema.org/Product">
          <div class="bf-card-meta">
            <span id="product-collection-label">
              {{ collection.title | default: 'BLED FAKE' | upcase }} // DROP
            </span>
            <span class="bf-card-index" id="product-num">
              {{ current_index | plus: 1 | prepend: '000' | slice: -3, 3 }} / {{ product_list.size | default: 1 | prepend: '000' | slice: -3, 3 }}
            </span>
          </div>

          <h1 class="bf-product-title" id="product-name">{{ current_product.title | upcase }}</h1>

          <div class="bf-product-price-row">
            <span class="bf-product-price-val" id="product-price">
              {{ current_variant.price | money }}
            </span>
            <span class="bf-product-price-compare" id="product-compare-price"{% unless current_variant.compare_at_price > current_variant.price %} style="display:none;"{% endunless %}>
              {{ current_variant.compare_at_price | money }}
            </span>
          </div>

          <!-- Add to Cart Form & Size Selection -->
          <form class="bf-add-cart-form" action="/cart/add" method="post" id="bf-add-form">
            <!-- Hidden input holding the real selected Shopify variant ID -->
            <input type="hidden" name="id" id="selected-variant-id" value="{{ current_variant.id }}">

            <div class="bf-size-group">
              <span class="bf-size-group-label">SELECT SIZE</span>
              <div class="bf-size-pills" id="bf-size-pills" role="group" aria-label="Sizes">
                {% if current_product.variants.size > 1 %}
                  {% for variant in current_product.variants %}
                    <button
                      type="button"
                      class="bf-size-pill{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-disabled{% endunless %}"
                      data-variant-id="{{ variant.id }}"
                      data-price="{{ variant.price }}"
                      data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                      data-available="{{ variant.available }}"
                      {% unless variant.available %}disabled title="Sold out"{% endunless %}
                    >
                      {{ variant.title }}
                    </button>
                  {% endfor %}
                {% else %}
                  <!-- Single variant / default sizes -->
                  <button
                    type="button"
                    class="bf-size-pill is-selected"
                    data-variant-id="{{ current_variant.id }}"
                    data-price="{{ current_variant.price }}"
                    data-compare-price="{{ current_variant.compare_at_price | default: 0 }}"
                    data-available="{{ current_variant.available }}"
                  >
                    {% if current_variant.title != 'Default Title' %}{{ current_variant.title }}{% else %}ONE SIZE{% endif %}
                  </button>
                {% endif %}
              </div>
            </div>

            <button
              type="submit"
              class="bf-cart-submit-btn"
              id="add-to-cart-btn"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span id="btn-text">
                {% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
              </span>
              <span aria-hidden="true">➔</span>
            </button>
          </form>
        </div>

      {% else %}
        <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 0;">
          <p style="font-family: var(--font-display); font-size: 2rem; color: var(--bf-off-white-40);">
            NO PRODUCTS FOUND IN THIS DROP
          </p>
        </div>
      {% endif %}

    </div>

    <!-- Next Arrow -->
    <button class="bf-gallery-nav-btn bf-gallery-nav-btn--next" id="next-btn" aria-label="Next product" {% if product_list.size <= 1 %}disabled{% endif %}>
      <div class="bf-nav-box">►</div>
      <span class="bf-nav-label">NEXT</span>
    </button>

  </div>

  <!-- ─── BOTTOM TICKER ──────────────────────────── -->
  <div class="bf-gallery-status-bar">
    <span>TUNISIAN UNDERGROUND STREET CULTURE</span>
    <span>AUTHENTIC LIMITED GARMENTS</span>
    <span>WORLDWIDE SHIPPING</span>
  </div>

</section>

{% schema %}
{
  "name": "BLED Store",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "BLED Store Page"
    }
  ]
}
{% endschema %}
