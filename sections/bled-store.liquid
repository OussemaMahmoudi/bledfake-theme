{% comment %}
  BLED FAKE — Store & Collection Section (bled-store.liquid)
  Clean, high-end underground streetwear gallery.
{% endcomment %}

{% if collection %}
  {% assign product_list = collection.products %}
{% elsif product %}
  {% assign product_list = collections.all.products %}
{% else %}
  {% assign product_list = collections.all.products %}
{% endif %}

{% if product %}
  {% assign current_product = product %}
  {% assign current_index = 0 %}
  {% for p in product_list %}
    {% if p.id == product.id %}
      {% assign current_index = forloop.index0 %}
    {% endif %}
  {% endfor %}
{% else %}
  {% assign current_product = product_list.first %}
  {% assign current_index = 0 %}
{% endif %}

<script>
window.bfProducts = [
  {%- for p in product_list -%}
  {
    "id":            {{ p.id }},
    "title":         {{ p.title | json }},
    "url":           {{ p.url | json }},
    "price":         {{ p.price }},
    "available":     {{ p.available }},
    "featured_image":{{ p.featured_image | image_url: width: 800 | json }},
    "variants": [
      {%- for v in p.variants -%}
      {
        "id":        {{ v.id }},
        "title":     {{ v.title | json }},
        "price":     {{ v.price }},
        "available": {{ v.available }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];
</script>

<section class="bf-store" id="bf-store" aria-label="BLED FAKE Store">

  <!-- Grain overlay -->
  <div class="bf-grain" aria-hidden="true"></div>

  <!-- ─── TOP HEADER ─────────────────────────────── -->
  <header class="bf-header" role="banner">
    <a href="/" class="bf-logo-link" aria-label="BLED FAKE — Home">
      {%- render 'bled-logo' -%}
      <span class="visually-hidden">BLED FAKE</span>
    </a>

    <div class="bf-nav-right">
      <button class="bf-nav-btn" data-cart-open aria-label="Open cart drawer">
        <span>CART</span>
        <span class="bf-cart-badge-count bf-cart-count">0</span>
      </button>

      <button class="bf-nav-btn" data-menu-open aria-label="Open menu">
        <span>MENU</span>
        <div class="bf-hamburger" aria-hidden="true">
          <div class="bf-hamburger__line"></div>
          <div class="bf-hamburger__line"></div>
        </div>
      </button>
    </div>
  </header>

  <!-- ─── COLLECTION TABS BAR ────────────────────── -->
  <nav class="bf-collection-bar" aria-label="Collections filter">
    {% assign active_handle = collection.handle | default: 'all' %}
    <a href="/collections/all" class="bf-collection-tab{% if active_handle == 'all' %} is-active{% endif %}">ALL DROPS</a>
    <a href="/collections/bledfake" class="bf-collection-tab{% if active_handle == 'bledfake' %} is-active{% endif %}">BLEDFAKE</a>
    <a href="/collections/bledhorra" class="bf-collection-tab{% if active_handle == 'bledhorra' %} is-active{% endif %}">BLEDHORRA</a>
    <a href="/collections/comeback-tommorow" class="bf-collection-tab{% if active_handle == 'comeback-tommorow' %} is-active{% endif %}">COMEBACK TOMMOROW</a>
  </nav>

  <!-- ─── MAIN GALLERY VIEWPORT ──────────────────── -->
  <div class="bf-gallery-viewport">

    <!-- Previous Arrow -->
    <button class="bf-gallery-nav-btn bf-gallery-nav-btn--prev" id="prev-btn" aria-label="Previous product" {% if product_list.size <= 1 %}disabled{% endif %}>
      <div class="bf-nav-box">◄</div>
      <span class="bf-nav-label">PREV</span>
    </button>

    <!-- Product Stage Grid -->
    <div class="bf-product-stage-grid" id="product-display" data-current-index="{{ current_index }}">

      {% if current_product %}

        <!-- Left: Floating Garment Stage with Ambient White Glow -->
        <div class="bf-garment-stage">
          <div class="bf-garment-glow" aria-hidden="true"></div>
          <div class="bf-garment-artwork">
            {% if current_product.featured_image %}
              <img
                class="bf-product-image"
                src="{{ current_product.featured_image | image_url: width: 800 }}"
                srcset="{{ current_product.featured_image | image_url: width: 400 }} 400w,
                        {{ current_product.featured_image | image_url: width: 800 }} 800w"
                sizes="(max-width: 900px) 90vw, 45vw"
                alt="{{ current_product.featured_image.alt | default: current_product.title | escape }}"
                loading="eager"
              >
            {% else %}
              <div class="bf-product-image-placeholder" aria-label="{{ current_product.title | escape }}">
                <svg viewBox="0 0 320 380" xmlns="http://www.w3.org/2000/svg" width="280">
                  <polygon points="95,45 130,70 190,70 225,45 305,100 275,175 240,155 240,360 80,360 80,155 45,175 15,100" fill="#121210" stroke="#2a2a26" stroke-width="2"/>
                  <path d="M 130,70 Q 160,95 190,70" fill="none" stroke="#3a3a34" stroke-width="2.5"/>
                  <rect x="110" y="140" width="100" height="14" fill="#F1EEE6" opacity="0.85"/>
                  <rect x="125" y="162" width="70" height="8" fill="#F1EEE6" opacity="0.6"/>
                </svg>
              </div>
            {% endif %}
          </div>
        </div>

        <!-- Right: Clean Product Info Card -->
        <div class="bf-product-info-card" itemscope itemtype="https://schema.org/Product">
          <div class="bf-card-meta">
            <span>BLED BLOCKS // COLLECTION</span>
            <span class="bf-card-index" id="product-num">
              {{ current_index | plus: 1 | prepend: '000' | slice: -3, 3 }} / {{ product_list.size | default: 1 | prepend: '000' | slice: -3, 3 }}
            </span>
          </div>

          <h2 class="bf-product-title" id="product-name">{{ current_product.title | upcase }}</h2>

          <div class="bf-product-price-row">
            <span class="bf-product-price-val" id="product-price">
              {{ current_product.selected_or_first_available_variant.price | money }}
            </span>
            {% if current_product.compare_at_price > current_product.price %}
              <span class="bf-product-price-compare">
                {{ current_product.compare_at_price | money }}
              </span>
            {% endif %}
          </div>

          <!-- Size Selector -->
          <form class="bf-add-cart-form" action="/cart/add" method="post">
            <div class="bf-size-group">
              <span class="bf-size-group-label">SELECT SIZE</span>
              <div class="bf-size-pills" role="group" aria-label="Sizes">
                {% if current_product.variants.size > 1 %}
                  {% for variant in current_product.variants %}
                    <label class="bf-size-pill{% if variant == current_product.selected_or_first_available_variant %} is-selected{% endif %}{% unless variant.available %} is-disabled{% endunless %}">
                      <input
                        type="radio"
                        name="id"
                        value="{{ variant.id }}"
                        class="visually-hidden"
                        {% if variant == current_product.selected_or_first_available_variant %}checked{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                      >
                      {{ variant.title }}
                    </label>
                  {% endfor %}
                {% else %}
                  {% assign default_sizes = "S,M,L,XL" | split: "," %}
                  {% for s in default_sizes %}
                    <label class="bf-size-pill{% if forloop.first %} is-selected{% endif %}">
                      <input
                        type="radio"
                        name="size_display"
                        value="{{ s }}"
                        class="visually-hidden"
                        {% if forloop.first %}checked{% endif %}
                      >
                      {{ s }}
                    </label>
                  {% endfor %}
                  <input type="hidden" name="id" value="{{ current_product.variants.first.id }}">
                {% endif %}
              </div>
            </div>

            <button type="submit" class="bf-cart-submit-btn" {% unless current_product.available %}disabled{% endunless %}>
              {% if current_product.available %}
                <span>ADD TO CART</span>
                <span>➔</span>
              {% else %}
                <span>SOLD OUT</span>
              {% endif %}
            </button>
          </form>
        </div>

      {% else %}
        <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 0;">
          <p style="font-family: var(--font-display); font-size: 2rem; color: var(--bf-off-white-40);">
            NO PRODUCTS FOUND IN THIS DROP
          </p>
        </div>
      {% endif %}

    </div>

    <!-- Next Arrow -->
    <button class="bf-gallery-nav-btn bf-gallery-nav-btn--next" id="next-btn" aria-label="Next product" {% if product_list.size <= 1 %}disabled{% endif %}>
      <div class="bf-nav-box">►</div>
      <span class="bf-nav-label">NEXT</span>
    </button>

  </div>

  <!-- ─── BOTTOM TICKER ──────────────────────────── -->
  <div class="bf-gallery-status-bar">
    <span>TUNISIAN UNDERGROUND STREET CULTURE</span>
    <span>AUTHENTIC LIMITED GARMENTS</span>
    <span>WORLDWIDE SHIPPING</span>
  </div>

</section>

{% schema %}
{
  "name": "BLED Store",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "BLED Store Page"
    }
  ]
}
{% endschema %}
