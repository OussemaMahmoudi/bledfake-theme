<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 420" class="bf-mascot-svg" aria-label="BLED FAKE mascot" role="img">

  <!-- Shadow on ground -->
  <ellipse cx="110" cy="412" rx="65" ry="8" fill="#030302" opacity="0.7"/>

  <!-- === HOODIE BODY === -->
  <polygon points="38,200 182,200 205,420 15,420" fill="#090908"/>
  <!-- Center seam -->
  <line x1="110" y1="200" x2="110" y2="420" stroke="#0e0e0c" stroke-width="2"/>
  <!-- Pocket rectangle -->
  <rect x="72" y="305" width="76" height="52" fill="#0c0c0b"/>
  <rect x="72" y="302" width="76" height="5" fill="#141412"/>

  <!-- === HOOD === -->
  <polygon points="55,98 165,98 182,200 38,200" fill="#0c0c0a"/>
  <!-- Hood edge highlight -->
  <polyline points="55,98 165,98" stroke="#1a1a18" stroke-width="2" fill="none"/>
  <!-- Center hood crease -->
  <line x1="110" y1="98" x2="110" y2="200" stroke="#0e0e0c" stroke-width="3"/>

  <!-- === HEAD — Off-white block, slightly irregular === -->
  <!-- Head shadow backing -->
  <rect x="58" y="56" width="108" height="58" fill="#0a0a09"/>
  <!-- Main head block -->
  <polygon points="60,54 214,57 212,114 58,116" fill="#F1EEE6"/>
  <!-- Slight texture cut -->
  <rect x="60" y="54" width="154" height="3" fill="#E8E5DD"/>

  <!-- === FACE DETAILS === -->
  <!-- Left eye — rectangular block -->
  <rect x="74"  y="70" width="34" height="18" fill="#050505"/>
  <!-- Right eye — rectangular block -->
  <rect x="116" y="70" width="34" height="18" fill="#050505"/>
  <!-- Eye glints -->
  <rect x="74"  y="70" width="6" height="5" fill="#F1EEE6" opacity="0.4"/>
  <rect x="116" y="70" width="6" height="5" fill="#F1EEE6" opacity="0.4"/>
  <!-- Brow bars -->
  <rect x="72"  y="64" width="38" height="4" fill="#0a0a09"/>
  <rect x="114" y="64" width="38" height="4" fill="#0a0a09"/>
  <!-- Nose bridge -->
  <rect x="106" y="82" width="8" height="20" fill="#D8D5CE" opacity="0.4"/>
  <!-- Mouth — subtle horizontal mark -->
  <rect x="82"  y="100" width="56" height="5" fill="#0a0a09" opacity="0.45"/>

  <!-- === COLLAR === -->
  <rect x="80" y="113" width="60" height="14" fill="#141412"/>
  <rect x="80" y="113" width="60" height="3" fill="#0a0a09"/>

  <!-- === BF CHEST MARK === -->
  <!-- B -->
  <rect x="76" y="228" width="6"  height="32" fill="#F1EEE6" opacity="0.85"/>
  <rect x="76" y="228" width="22" height="5"  fill="#F1EEE6" opacity="0.85"/>
  <rect x="76" y="242" width="20" height="5"  fill="#F1EEE6" opacity="0.85"/>
  <rect x="76" y="255" width="22" height="5"  fill="#F1EEE6" opacity="0.85"/>
  <rect x="92" y="228" width="6"  height="20" fill="#F1EEE6" opacity="0.85"/>
  <rect x="92" y="247" width="6"  height="13" fill="#F1EEE6" opacity="0.85"/>
  <!-- F -->
  <rect x="108" y="228" width="6"  height="32" fill="#F1EEE6" opacity="0.85"/>
  <rect x="108" y="228" width="24" height="5"  fill="#F1EEE6" opacity="0.85"/>
  <rect x="108" y="242" width="20" height="5"  fill="#F1EEE6" opacity="0.85"/>

  <!-- === LEFT ARM / SLEEVE === -->
  <polygon points="14,208 42,208 28,340 4,340"  fill="#0a0a08"/>
  <!-- Left hand block -->
  <rect x="2"  y="335" width="28" height="22" rx="0" fill="#F1EEE6" opacity="0.9"/>
  <!-- Hand knuckle detail -->
  <rect x="4"  y="335" width="24" height="3" fill="#D4D1C9" opacity="0.4"/>

  <!-- === RIGHT ARM / SLEEVE === -->
  <polygon points="178,208 206,208 218,340 192,340" fill="#0a0a08"/>
  <!-- Right hand block -->
  <rect x="190" y="335" width="28" height="22" rx="0" fill="#F1EEE6" opacity="0.9"/>
  <!-- Hand knuckle detail -->
  <rect x="192" y="335" width="24" height="3" fill="#D4D1C9" opacity="0.4"/>

  <!-- === HOODIE DETAILS === -->
  <!-- Side seam lines -->
  <line x1="52"  y1="205" x2="25"  y2="420" stroke="#0e0e0c" stroke-width="1.5"/>
  <line x1="168" y1="205" x2="195" y2="420" stroke="#0e0e0c" stroke-width="1.5"/>

</svg>
